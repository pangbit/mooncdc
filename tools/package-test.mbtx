///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
enum PackagePhase {
  Full
  Consumers
} derive(Eq, Debug)

///|
fn package_phase(args : Array[String]) -> PackagePhase raise {
  match args {
    [_] | [_, "--phase", "full"] => Full
    [_, "--phase", "consumers"] => Consumers
    _ => fail("usage: package-test.mbtx [--phase full|consumers]")
  }
}

///|
test "package phase defaults to full and accepts explicit stages" {
  assert_eq(package_phase(["driver"]), Full)
  assert_eq(package_phase(["driver", "--phase", "full"]), Full)
  assert_eq(package_phase(["driver", "--phase", "consumers"]), Consumers)
}

///|
test "package phase rejects unknown incomplete and extra arguments" {
  for
    args in [
      [],
      ["driver", "--phase"],
      ["driver", "--phase", "consumer"],
      ["driver", "consumers"],
      ["driver", "--phase", "consumers", "extra"],
      ["driver", "--phase", "full", "--phase", "consumers"],
    ] {
    try package_phase(args) catch {
      _ => ()
    } noraise {
      _ => fail("invalid phase arguments accepted")
    }
  }
}

///|
fn require_test_summary(output : String, count : Int) -> Unit raise {
  assert_true(count >= 0)
  let expected = "Total tests: \{count}, passed: \{count}, failed: 0."
  let summaries = output
    .split("\n")
    .filter(line => line.has_prefix("Total tests:"))
    .collect()
  assert_eq(summaries.length(), 1)
  assert_eq(summaries[0], expected)
}

///|
fn test_identities(outline : String) -> Array[String] raise {
  let identities : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  for line in outline.split("\n").filter(line => !line.trim().is_empty()) {
    guard line.trim().split_once(". ") is Some((ordinal, identity)) else {
      fail("invalid test outline")
    }
    assert_eq(@string.parse_int(ordinal), identities.length() + 1)
    let identity = identity.to_owned()
    assert_true(identity.contains(" index="))
    assert_false(seen.contains(identity), msg="duplicate test identity")
    seen[identity] = true
    identities.push(identity)
  }
  assert_true(!identities.is_empty(), msg="empty ordinary test discovery")
  identities
}

///|
fn require_same_tests(source : String, packaged : String) -> Int raise {
  let expected = test_identities(source)
  assert_eq(test_identities(packaged), expected)
  expected.length()
}

///|
fn ordinary_packages(identities : Array[String]) -> Array[String] raise {
  let packages : Array[String] = []
  for identity in identities {
    guard identity.split_once(" ") is Some((name, _)) else {
      fail("test package")
    }
    let name = name.to_owned()
    if !packages.contains(name) {
      packages.push(name)
    }
  }
  assert_true(!packages.is_empty())
  packages
}

///|
async fn[T] watch_package_command(
  command : async () -> T,
  sample : async () -> Unit,
) -> T {
  sample()
  @async.with_task_group() <| group => {
    let child = group.spawn(no_wait=true, command)
    let monitor = group.spawn(no_wait=true, () => {
      while true {
        @async.sleep(1000)
        sample()
      }
    })
    defer monitor.cancel()
    let result = child.wait()
    sample()
    result
  }
}

///|
async test "package disk failure cancels and joins the running command" {
  let joined = Ref(false)
  let calls = Ref(0)
  try
    watch_package_command(
      () => {
        defer {
          joined.val = true
        }
        @async.sleep(5000)
      },
      () => {
        calls.val += 1
        if calls.val > 1 {
          fail("simulated disk breach")
        }
      },
    )
  catch {
    _ => ()
  } noraise {
    _ => fail("expected sampler failure")
  }
  assert_true(joined.val)
}

///|
test "ordinary package groups preserve every identity exactly once" {
  let identities = test_identities(
    "1. p a.mbt:1 index=0\n2. p b.mbt:1 index=0\n3. p/c c.mbt:1 index=0\n",
  )
  assert_eq(ordinary_packages(identities), ["p", "p/c"])
  let grouped : Array[String] = []
  for pkg in ordinary_packages(identities) {
    for identity in identities.filter(s => s.has_prefix(pkg + " ")) {
      grouped.push(identity)
    }
  }
  assert_eq(grouped, identities)
}

///|
test "ordinary coverage rejects omissions and equal-count substitutions" {
  let source = "1. p a.mbt:2 index=0 name=\"a\"\n2. p b.mbt:2 index=0\n"
  assert_eq(require_same_tests(source, source), 2)
  for
    invalid in [
      "", "1. p a.mbt:2 index=0 name=\"a\"\n", "1. p a.mbt:2 index=0 name=\"a\"\n2. p c.mbt:2 index=0\n",
      "1. p b.mbt:2 index=0\n2. p b.mbt:2 index=0\n", "2. p a.mbt:2 index=0\n",
    ] {
    try require_same_tests(source, invalid) catch {
      _ => ()
    } noraise {
      _ => fail("expected coverage rejection")
    }
  }
}

///|
test "ordinary summary rejects stale incomplete failed and duplicate results" {
  require_test_summary("Total tests: 0, passed: 0, failed: 0.\n", 0)
  for
    invalid in [
      "Total tests: 439, passed: 439, failed: 0.\n", "Total tests: 451, passed: 450, failed: 1.\n",
      "Total tests: 451, passed: 450, failed: 0.\n", "prefix Total tests: 451, passed: 451, failed: 0.\n",
      "Total tests: 451, passed: 451, failed: 0.\nTotal tests: 451, passed: 451, failed: 0.\n",
    ] {
    try require_test_summary(invalid, 451) catch {
      _ => ()
    } noraise {
      _ => fail("expected summary rejection")
    }
  }
}

///|
test "ordinary coverage follows current source instead of a historical total" {
  require_test_summary("Total tests: 451, passed: 451, failed: 0.\n", 451)
}

///|
async fn main {
  let phase = package_phase(@env.args())
  let repo = @env.current_dir().unwrap()
  let evidence = @fs.tmpdir(prefix="mooncdc-package-evidence-")
  let owned = @fs.tmpdir(prefix="mooncdc-package-owned-")
  defer @async.protect_from_cancel(() => @fs.rmdir(owned, recursive=true))
  let root = owned + "/committed"
  @fs.mkdir(root)
  @fs.write_file(evidence + "/root.txt", evidence)
  println("PACKAGE ROOT: " + evidence)
  println("PACKAGE OWNED ROOT: " + owned)
  let vars : Map[String, String] = Map([])
  for
    key in [
      "PATH", "HOME", "TMPDIR", "MOON_HOME", "MOON_CACHE_DIR", "MOON_DEP_CACHE",
      "XDG_CACHE_HOME", "LANG", "LC_ALL",
    ] {
    if @env.get_env_var(key) is Some(value) {
      vars[key] = value
    }
  }
  vars["RUST_LOG"] = "error"
  @fs.mkdir(owned + "/tmp")
  // Keep compiler scratch in the ledger where tools honor TMPDIR.
  vars["TMPDIR"] = owned + "/tmp"
  let commands : Array[Json] = []
  let started = @async.now()
  let retained : Array[String] = match
    @env.get_env_var("MOONCDC_PACKAGE_RETAINED_EVIDENCE") {
    None => []
    Some(text) => {
      guard @json.parse(text) is Array(values) else {
        fail("retained evidence array")
      }
      values.map(v => {
        guard v is String(path) &&
          path.has_prefix("/tmp/mooncdc-package-evidence-") else {
          fail("retained evidence path")
        }
        path
      })
    }
  }
  let sample = async fn(phase : String) -> Unit {
    let size = @shell.Cmd("du", ["-sk", owned, evidence] + retained).output(
      timeout_ms=5000,
      max_output_bytes=16384,
    )
    size.check()
    let mut kib = 0
    for line in size.stdout().split("\n").filter(s => !s.is_empty()) {
      kib += @string.parse_int(line.split("\t").next().unwrap())
    }
    let record : Json = {
      "phase": phase.to_json(),
      "elapsed_ms": (@async.now() - started).to_json(),
      "allocated_kib": kib.to_json(),
      "limit_kib": 524288,
    }
    @fs.write_file(
      evidence + "/disk-samples.jsonl",
      record.stringify() + "\n",
      append=true,
      create_mode=OpenOrCreate,
    )
    assert_true(kib <= 524288, msg="sampled package allocation exceeds 512 MiB")
  }
  let run_env = async fn(
    name : String,
    program : String,
    args : Array[String],
    cwd : String,
    extra : Map[String, String],
  ) -> @shell.Output {
    assert_true(@async.now() - started < 1800000L)
    let env = vars.copy()
    for key, value in extra {
      env[key] = value
    }
    let tick = @async.now()
    let result = watch_package_command(
      () => {
        @shell.Cmd(program, args, cwd~, env~, inherit_env=false).output(
          timeout_ms=300000,
          max_output_bytes=20000000,
        )
      },
      () => sample(name),
    )
    @fs.write_file(evidence + "/" + name + ".stdout", result.stdout_bytes())
    @fs.write_file(evidence + "/" + name + ".stderr", result.stderr())
    commands.push({
      "name": name.to_json(),
      "program": program.to_json(),
      "args": args.to_json(),
      "cwd": cwd.to_json(),
      "extra_env_names": extra.keys().collect().to_json(),
      "exit_code": result.exit_code().to_json(),
      "elapsed_ms": (@async.now() - tick).to_json(),
    })
    @fs.write_file(
      evidence + "/commands.json",
      commands.to_json().stringify(indent=2),
    )
    println(
      "PACKAGE AUDIT: " + name + " exit=" + result.exit_code().to_string(),
    )
    sample(name + "-recorded")
    result
  }
  let run = async fn(
    name : String,
    program : String,
    args : Array[String],
    cwd : String,
  ) -> @shell.Output {
    run_env(name, program, args, cwd, Map([]))
  }
  let footprints : Array[Json] = []
  let disk = async fn(phase : String) -> Unit {
    let size = run(
      "disk-" + phase,
      "du",
      ["-sk", owned, evidence] + retained,
      repo,
    )
    size.check()
    let mut kib = 0
    for line in size.stdout().split("\n") {
      if !line.is_empty() {
        kib += @string.parse_int(line.split("\t").next().unwrap())
      }
    }
    footprints.push({
      "phase": phase.to_json(),
      "owned_and_all_retained_evidence_kib": kib.to_json(),
    })
    @fs.write_file(
      evidence + "/disk.json",
      ({ "limit_kib": 524288, "measurements": footprints.to_json() } : Json).stringify(
        indent=2,
      ),
    )
    assert_true(kib <= 524288)
  }
  let source = run("source", "git", ["rev-parse", "HEAD", "HEAD^{tree}"], repo)
  source.check()
  let revision = source.stdout().split("\n").next().unwrap().to_owned()
  let initial = run("initial-status", "git", ["status", "--porcelain=v1"], repo)
  initial.check()
  assert_eq(initial.stdout(), "")
  run(
    "tested-source",
    "git",
    ["diff", "--binary", "HEAD", "--", ".", ":(exclude)docs/reports/evidence"],
    repo,
  ).check()
  run("toolchain", "moon", ["version", "--all"], repo).check()
  run("host", "uname", ["-a"], repo).check()
  let files = run(
    "committed-files",
    "git",
    ["ls-tree", "-r", "--name-only", "-z", revision],
    repo,
  )
  files.check()
  let paths = files
    .stdout()
    .split("\u0000")
    .filter(p => {
      !p.is_empty() &&
      !p.has_prefix("docs/reports/evidence/") &&
      !p.has_prefix("extensions/") &&
      p != "moon.work"
    })
    .map(p => p.to_owned())
    .collect()
  run(
    "commit-archive",
    "git",
    [
      "archive",
      "--format=tar",
      "--output=" + evidence + "/source.tar",
      revision,
    ] +
    paths,
    repo,
  ).check()
  run(
    "commit-extract",
    "tar",
    ["-xf", evidence + "/source.tar", "-C", root],
    owned,
  ).check()
  // Only the pre-existing third-party cache is copied from the checkout.
  // Product source, native stubs and reference fixtures come from this commit.
  run(
    "stage-cache",
    "cp",
    ["-R", repo + "/.mooncakes", root + "/.mooncakes"],
    owned,
  ).check()
  let original : Map[String, Bytes] = Map([])
  for path in paths {
    original[path] = @fs.read_file(root + "/" + path).binary()
  }
  run("source-sha256", "shasum", ["-a", "256"] + paths, root).check()
  let source_outline = if phase is Full {
    let result = run(
      "source-ordinary-outline",
      "moon",
      ["test", "--outline", "--target", "native", "--frozen", "--deny-warn"],
      root,
    )
    result.check()
    @fs.write_file(
      evidence + "/ordinary-test-identities.json",
      test_identities(result.stdout()).to_json().stringify(indent=2),
    )
    run("doc", "moon", ["doc", "--frozen"], root).check()
    Some(result.stdout())
  } else {
    None
  }
  run("package-list", "moon", ["package", "--list", "--frozen"], root).check()
  run("package", "moon", ["package", "--frozen"], root).check()
  let archive = root + "/_build/publish/pangbit-mooncdc-0.1.0.zip"
  @fs.write_file(evidence + "/package.zip", @fs.read_file(archive))
  let listing = run("package-contents", "unzip", ["-Z1", archive], root)
  listing.check()
  let contents = listing.stdout()
  for
    excluded in [
      "_build/", ".test-artifacts/", ".mooncakes/", ".git/", ".key", ".checkpoint",
      "docs/reports/evidence/", "extensions/", "moon.work", ".github/workflows/extensions.yml",
      "bigquery_auth.c", "snowflake_zstd.c",
    ] {
    assert_false(contents.contains(excluded))
  }
  for
    required in [
      "LICENSE", "README.mbt.md", "moon.mod", "moon.pkg", "subscription.mbt", "snapshot.mbt",
      "destination.mbt", "pipeline.mbt", "pipeline_apply_retry.mbt", "pipeline_schema_cleanup.mbt",
      "activity.mbt", "health_server.mbt", "health_errno.c", "table_sync_copy.mbt",
      "memory.mbt", "batch.mbt", "snapshot_batch.mbt", "connection_options.c", "session_options.mbt",
      "state_store.mbt", "file_state_store.mbt", "postgres_state_store.mbt", "schema_store.mbt",
      "schema_projection.mbt", "schema_plan.mbt", "cell.mbt", "cell_float.c", "clickhouse_destination.mbt",
      "clickhouse_metadata.mbt", "clickhouse_defaults.mbt", "clickhouse_rows.mbt",
      "clickhouse_http.mbt", "clickhouse_encoding.mbt", "clickhouse_schema.mbt",
      "clickhouse_ddl.mbt", "examples/resume/main.mbt", "cmd/replicator/main.mbt",
      "cmd/replicator/config.mbt", "cmd/replicator/moon.pkg", "source_migrations.mbt",
      "source_migrations_sql.mbt", "integration/reference/etl/LICENSE", "integration/reference/pglogrepl-expected.json",
      "internal/yaml/LICENSE", "internal/yaml/README.md", "integration/reference/memory-expected.json",
      "internal/memory/policy.mbt", "internal/memory/host_memory.c", "internal/memory/sampler.mbt",
      "internal/memory/linux_memory.mbt", "internal/memory/LICENSE-sysinfo", "internal/memory/monitor.mbt",
      "internal/memory/governor.mbt", "internal/memory/moon.pkg", "internal/yaml/config.mbt",
      "internal/yaml/lexer.mbt", "internal/yaml/parser.mbt", "internal/yaml/moon.pkg",
      "decoder_streaming.mbt", "streaming_subscription_wbtest.mbt", "integration/reference/pglogrepl-v2-expected.json",
      "wal_batch.mbt", "timeline_recovery.mbt", "state_runtime.mbt", "metrics.mbt",
      "metrics_server.mbt", "source_monitor.mbt", "copy_monitor.mbt", "snapshot_parallel.mbt",
      "cmd/replicator/error_reports.mbt", "cmd/replicator/configcat.mbt", "cmd/replicator/configcat_wbtest.mbt",
      "docs/REPLICATOR.md", "docs/METRICS.md", "docs/PIPELINE_CONFIG_MAPPING.md",
      "docs/RELEASE_SCOPE.md", "destination_events.mbt", "pkg.generated.mbti", "tools/package-test.mbtx",
      "tools/replicator-config-test.mbtx",
    ] {
    assert_true(contents.split("\n").any(path => path == required))
  }
  let dir = owned + "/extracted"
  @fs.mkdir(dir)
  @fs.mkdir(dir + "/module")
  @fs.mkdir(dir + "/consumer")
  @shell.Cmd("unzip", ["-q", archive, "-d", dir + "/module"]).run()
  // Frozen workspace resolution uses only the existing local dependency cache.
  run(
    "consumer-cache",
    "cp",
    ["-R", root + "/.mooncakes", dir + "/.mooncakes"],
    owned,
  ).check()
  // Reject symlink escapes; workspace resolution must not point at the source checkout.
  let links = run("workspace-symlinks", "find", [dir, "-type", "l"], owned)
  links.check()
  assert_eq(links.stdout(), "")
  run(
    "unpacked-sha256",
    "shasum",
    ["-a", "256"] +
    contents
    .split("\n")
    .filter(p => !p.is_empty())
    .map(p => p.to_owned())
    .collect(),
    dir + "/module",
  ).check()
  @fs.write_file(dir + "/moon.work", "members = [\"module\", \"consumer\"]\n")
  let manifest =
    #|name = "validation/consumer"
    #|preferred_target = "native"
    #|supported_targets = "native"
    #|import { "pangbit/mooncdc@0.1.0", "moonbitlang/async@0.22.4" }
  @fs.write_file(dir + "/consumer/moon.mod", manifest)
  let package_manifest =
    #|import { "pangbit/mooncdc" @cdc, "moonbitlang/async", "moonbitlang/async/fs" }
    #|pkgtype(kind: "executable")
    #|supported_targets = "native"
  @fs.write_file(dir + "/consumer/moon.pkg", package_manifest)
  let main_source =
