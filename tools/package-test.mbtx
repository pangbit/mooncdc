    #|  let lsn = @cdc.Lsn::parse("1/ABC")
    #|  assert_eq(lsn.to_string(), "1/ABC")
    #|  assert_true(@cdc.Null != @cdc.UnchangedToast)
    #|  assert_true(@cdc.Binary(b"\x00\xff") != @cdc.Null)
    #|  assert_true(@cdc.Accepted != @cdc.Durable)
    #|  assert_true(@cdc.V1 != @cdc.V2Streaming)
    #|  assert_eq(@cdc.Text("42").decode_text(23U), @cdc.I32(42))
    #|  assert_eq(@cdc.Null.decode_text(25U), @cdc.SqlNull)
    #|  assert_eq(@cdc.SchemaId::before_lsn(@cdc.Lsn::parse("1/0")).commit_lsn.to_string(), "0/FFFFFFFF")
    #|  let _schema = @cdc.SchemaSnapshot::from_json({
    #|    "commit_lsn":"0/30", "message_lsn":"0/20", "payload":{
    #|      "command_tag":"CREATE TABLE", "nspname":"public", "relname":"t", "oid":42,
    #|      "identity":{"primary_key_attnums":[1],"relreplident":"d","replica_identity_index_attnums":[]},
    #|      "columns":[{"attname":"id","atttypid":23,"atttypmod":-1,"attnum":1,"attnotnull":true}]}}
