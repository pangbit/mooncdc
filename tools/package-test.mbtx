    #|impl @cdc.Destination for DummyDestination with fn supports_wal_batches(_self) { true }
    #|///|
    #|impl @cdc.Destination for DummyDestination with fn write_wal_batch(_self, batch) { ignore(batch.replicated_schemas(0)); ignore(batch.destination_events().event_id(0)); @cdc.Durable }
    #|///|
    #|impl @cdc.Destination for DummyDestination with fn write_rows(_self, _relation, _rows, _id) { @cdc.Durable }
    #|///|
    #|impl @cdc.Destination for DummyDestination with fn write_transaction(_self, tx) { ignore(tx.replicated_schemas(0)); ignore(tx.destination_events().replicated_schemas(0)); @cdc.Durable }
    #|///|
    #|impl @cdc.Destination for DummyDestination with fn flush(_self) { () }
  @fs.write_file(dir + "/consumer/main.mbt", main_source)
  for name in ["moon.mod", "moon.pkg", "main.mbt"] {
    @fs.write_file(
      evidence + "/consumer-" + name + ".txt",
      @fs.read_file(dir + "/consumer/" + name),
    )
  }
  @fs.write_file(
    evidence + "/workspace.moon.work.txt",
    @fs.read_file(dir + "/moon.work"),
  )
  run(
    "consumer-check",
    "moon",
    ["check", "--target", "native", "--deny-warn", "--frozen", "--jobs", "1"],
    dir + "/consumer",
  ).check()
  for mode in ["debug", "release"] {
    let args = [
      "run", ".", "--target", "native", "--frozen", "--deny-warn", "--jobs", "1",
    ]
    if mode == "release" {
      args.push("--release")
    }
    let result = run("consumer-" + mode, "moon", args, dir + "/consumer")
    result.check()
    assert_true(
      result.stdout().contains("Extracted core package consumer passed"),
    )
  }
  let consumer_files = run(
    "consumer-artifact-files",
    "rg",
    ["--files", "--hidden", "--no-ignore", dir + "/_build"],
    owned,
  )
  consumer_files.check()
  let consumers = consumer_files
    .stdout()
    .split("\n")
    .filter(p => {
      p.has_suffix("/consumer.exe") &&
      !p.contains(".dSYM/") &&
      (
        p.contains("/native/debug/build/") ||
        p.contains("/native/release/build/")
      )
    })
    .map(p => p.to_owned())
    .collect()
  assert_eq(consumers.length(), 2)
  run("consumer-executables-sha256", "shasum", ["-a", "256"] + consumers, owned).check()
  disk("consumers")
  @fs.rmdir(dir + "/_build/native/release", recursive=true)
  // A missing shipped native stub must break a fresh consumer build. This
  // negative control detects resolution accidentally falling back to checkout.
  {
    let path = dir + "/module/cell_float.c"
    let bytes = @fs.read_file(path)
    defer @fs.write_file(path, bytes)
    @fs.remove(path)
    let missing = run(
      "consumer-missing-stub",
      "moon",
      [
        "build",
        "--target",
        "native",
        "--frozen",
        "--deny-warn",
        "--jobs",
        "1",
        "--target-dir",
        dir + "/negative-build",
      ],
      dir + "/consumer",
    )
    assert_true(missing.exit_code() != 0)
    assert_true((missing.stdout() + missing.stderr()).contains("cell_float.c"))
  }
  @fs.rmdir(dir + "/negative-build", recursive=true)
  // Both consumers and the missing-stub control have already been verified.
  // Their hashes/logs and source archives remain in evidence.
  @fs.rmdir(dir + "/_build", recursive=true)
  @fs.rmdir(root + "/_build", recursive=true)
  if phase is Consumers {
    for path in contents.split("\n").filter(p => !p.is_empty()) {
      assert_eq(
        @fs.read_file(root + "/" + path.to_owned()).binary(),
        @fs.read_file(dir + "/module/" + path.to_owned()).binary(),
      )
    }
    for path in paths {
      assert_eq(@fs.read_file(root + "/" + path).binary(), original[path])
    }
    run("final-source-sha256", "shasum", ["-a", "256"] + paths, root).check()
    let digest = run(
      "package-sha256",
      "shasum",
      ["-a", "256", evidence + "/package.zip"],
      owned,
    )
    digest.check()
    assert_true(digest.stdout().length() >= 66)
    disk("consumers-finish")
    @fs.write_file(
      evidence + "/summary.json",
      (
        {
          "phase": "consumers",
          "source_commit": revision.to_json(),
          "package_sha256": digest.stdout()[:64].to_owned().to_json(),
          "source_unchanged": true,
          "consumer": "strict check, debug/release public core and ClickHouse assertions; missing native stub rejection",
          "full_package_flow": false,
          "packaged_ordinary": "not run",
          "extracted_cli": "not run",
          "script_test_mode": "not run",
          "doc_info_fmt": "not run",
          "runtime_services": false,
          "package_entries": contents
          .split("\n")
          .filter(p => !p.is_empty())
          .count()
          .to_json(),
          "cleanup": "owned module/consumer/build removed on scope exit; evidence retained",
        } : Json).stringify(indent=2),
    )
    println("PACKAGE consumers complete: ordinary suite and CLI matrix not run")
    return
  }
  let source_outline = source_outline.unwrap()
  let source_tests = test_identities(source_outline)
  let packaged_outline = run(
    "packaged-ordinary-outline",
    "moon",
    ["test", "--outline", "--target", "native", "--frozen", "--deny-warn"],
    dir + "/module",
  )
  packaged_outline.check()
  let ordinary_count = require_same_tests(
    source_outline,
    packaged_outline.stdout(),
  )
  let ordinary_build = dir + "/ordinary-build"
  let mut executed = 0
  for i, pkg in ordinary_packages(source_tests) {
    let expected = source_tests.filter(s => s.has_prefix(pkg + " "))
    let args = [
      "--package", pkg, "--target", "native", "--deny-warn", "--frozen", "--jobs",
      "1", "--target-dir", ordinary_build,
    ]
    let prefix = "packaged-ordinary-" + i.to_string()
    let outline = run(
      prefix + "-outline",
      "moon",
      ["test", "--outline"] + args,
      dir + "/module",
    )
    outline.check()
    assert_eq(test_identities(outline.stdout()), expected)
    let ordinary = run(
      prefix,
      "moon",
      ["test", "--no-parallelize"] + args,
      dir + "/module",
    )
    ordinary.check()
    require_test_summary(ordinary.stdout(), expected.length())
    executed += expected.length()
    let files = run(
      prefix + "-executables",
      "find",
      [ordinary_build, "-type", "f", "-name", "*.exe"],
      owned,
    )
    files.check()
    let executables = files
      .stdout()
      .split("\n")
      .filter(s => !s.is_empty())
      .map(s => s.to_owned())
      .collect()
    assert_true(!executables.is_empty())
    run(
      prefix + "-executables-sha256",
      "shasum",
      ["-a", "256"] + executables,
      owned,
    ).check()
    disk("ordinary-" + i.to_string())
    @fs.rmdir(ordinary_build, recursive=true)
  }
  assert_eq(executed, ordinary_count)
  disk("ordinary")
  let config_results = run_env(
    "packaged-config-driver",
    "moon",
    [
      "run", "tools/replicator-config-test.mbtx", "--target", "native", "--frozen",
    ],
    dir + "/module",
    { "MOONCDC_PACKAGE_CONFIG_SCRATCH": owned + "/config-driver" },
  )
  config_results.check()
  assert_true(
    config_results
    .stdout()
    .contains("REPLICATOR CONFIG: 32 isolated CLI outcomes"),
  )
  // Moon 914d7da appends the standalone filename to --target-dir and test-mode
  // uses that directory's .mooncakes rather than run-mode's shared source cache.
  // Seed only the already cached dependency, in owned disposable directories.
  // Run each script's discovered test blocks without executing its main or
  // claiming an ASAN/database result.
  let script_build = dir + "/script-test-build"
  for name in ["package-test", "replicator-config-test"] {
    let filename = name + ".mbtx"
    let cache = script_build + "/" + filename + "/.mooncakes/moonbitlang"
    @fs.mkdir(cache, recursive=true)
    @shell.Cmd("cp", [
      "-R",
      root + "/.mooncakes/moonbitlang/async",
      cache + "/async",
    ]).run()
    let outline = run(
      "script-outline-" + name,
      "moon",
      [
        "test",
        "tools/" + filename,
        "--outline",
        "--target",
        "native",
        "--deny-warn",
        "--frozen",
        "--target-dir",
        script_build,
      ],
      dir + "/module",
    )
    outline.check()
    let count = if outline.stdout().trim().is_empty() {
      0
    } else {
      test_identities(outline.stdout()).length()
    }
    let result = run(
      "script-test-mode-" + name,
      "moon",
      [
        "test",
        "tools/" + filename,
        "--target",
        "native",
        "--deny-warn",
        "--frozen",
        "--jobs",
        "1",
        "--target-dir",
        script_build,
      ],
      dir + "/module",
    )
    result.check()
    require_test_summary(result.stdout(), count)
    disk("script-" + name)
    @fs.rmdir(script_build, recursive=true)
  }
  run(
    "extracted-cli-release",
    "moon",
    [
      "build",
      "cmd/replicator",
      "--target",
      "native",
      "--release",
      "--frozen",
      "--deny-warn",
      "--jobs",
      "1",
      "--target-dir",
      dir + "/cli-build",
    ],
    dir + "/module",
  ).check()
  let built = @shell.Cmd("rg", [
    "--files",
    "--hidden",
    "--no-ignore",
    dir + "/cli-build",
  ]).output()
  built.check()
  let executables = built
    .stdout()
    .split("\n")
    .filter(p => p.has_suffix("/cmd/replicator/replicator.exe"))
    .map(p => p.to_owned())
    .collect()
  assert_eq(executables.length(), 1)
  let executable = executables[0]
  // Parse the actual workflow through the shipped YAML parser. A configuration
  // field rejection proves YAML parsing completed; this is not GitHub execution.
  let ci = run(
    "ci-yaml-parse",
    executable,
    ["--config", root + "/.github/workflows/ci.yml", "--check"],
    dir + "/module",
  )
  assert_eq(ci.exit_code(), 1)
  assert_true(ci.stderr().contains("config: unsupported field "))
  assert_false(ci.stderr().contains("not valid YAML"))
  assert_eq(ci.stdout(), "")
  for format in ["json", "yaml"] {
    let config = dir + "/offline." + format
    if format == "json" {
      @fs.write_file(
        config,
        (
          {
            "id": "package-consumer",
            "publication": "unused",
            "source": {
              "host": "127.0.0.1",
              "port": 1,
              "user": "cdc",
              "security": "local_plaintext",
            },
            "destination": {
              "type": "clickhouse",
              "url": "http://127.0.0.1:1",
              "user": "cdc",
              "database": "unused",
            },
            "metrics": Json::null(),
            "supabase": {
              "project_ref": "package-test",
              "configcat_sdk_key": "abcdefghijklmnopqrstuv/ABCDEFGHIJKLMNOPQRSTUV",
            },
          } : Json).stringify(),
      )
    } else {
      let yaml =
        #|id: package-consumer
        #|publication: unused
        #|source: {host: 127.0.0.1, port: 1, user: cdc, security: local_plaintext}
        #|destination: {type: clickhouse, url: http://127.0.0.1:1, user: cdc, database: unused}
        #|metrics: null
        #|supabase: {project_ref: package-test, configcat_sdk_key: abcdefghijklmnopqrstuv/ABCDEFGHIJKLMNOPQRSTUV}
      @fs.write_file(config, yaml)
    }
    @fs.write_file(evidence + "/offline." + format, @fs.read_file(config))
    run(
      "extracted-cli-" + format,
      executable,
      ["--config", config, "--check"],
      dir + "/module",
    ).check()
  }
  run("executables-sha256", "shasum", ["-a", "256", executable], owned).check()
  run(
    "archive-sha256",
    "shasum",
    ["-a", "256", evidence + "/source.tar", evidence + "/package.zip"],
    owned,
  ).check()
  run("packaged-info", "moon", ["info", "--frozen"], dir + "/module").check()
  run("packaged-fmt", "moon", ["fmt"], dir + "/module").check()
  for path in contents.split("\n").filter(p => !p.is_empty()) {
    assert_eq(
      @fs.read_file(root + "/" + path.to_owned()).binary(),
      @fs.read_file(dir + "/module/" + path.to_owned()).binary(),
    )
  }
  disk("release")
  for path in paths {
    if @fs.read_file(root + "/" + path).binary() != original[path] {
      fail("source changed: " + path)
    }
  }
  run("final-source-sha256", "shasum", ["-a", "256"] + paths, root).check()
  disk("finish")
  @fs.write_file(
    evidence + "/summary.json",
    (
      {
        "source_commit": revision.to_json(),
        "dependency_policy": "all resolver/build commands frozen; only existing third-party .mooncakes copied; committed Git archive excludes historical evidence; module and consumer use an owned workspace with no symlinks",
        "source_unchanged": true,
        "consumer": "strict native check plus debug/release core assertions; missing packed native stub rejects fresh build",
        "extracted_cli": "strict release build; ClickHouse JSON/YAML offline checks; other targets rejected by core CLI regression",
        "packaged_ordinary": "\{ordinary_count}/\{ordinary_count} native ordinary entries; exact source/package identity equality; gated PG/cloud workers not enabled".to_json(),
        "script_test_mode": "two packaged drivers strict native frozen tests against discovered counts; main not executed; existing async copied to disposable standalone target-dir/filename/.mooncakes",
        "packaged_config_driver": "main executed separately; 32 offline configuration results",
        "runtime_services": false,
        "ci": "committed workflow YAML parsed by shipped parser; remote jobs not run",
        "linux": (if @async.platform is Linux {
          "executed on Linux; default-stack compilation and full acceptance remain separate"
        } else {
          "not executed on Linux; see host.stdout"
        }).to_json(),
        "cleanup": "disposable consumer/module/build directory removed on scope exit",
        "package_entries": contents
        .split("\n")
        .filter(p => !p.is_empty())
        .count()
        .to_json(),
      } : Json).stringify(indent=2),
  )
  println(
    "PACKAGE complete: source archive,current independent consumer and extracted CLI passed offline with frozen cached dependencies",
  )
}
