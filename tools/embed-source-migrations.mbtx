///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
}

///|
async fn main {
  let files = ["schema-change-messages", "publication-schema-change-messages"]
  let mut output = "// Generated by tools/embed-source-migrations.mbtx. Do not edit.\n// Supabase ETL c1eb3f8f746c1c0394c103e7fdf8f17527de5fd4, Apache-2.0.\n// License: integration/reference/etl/LICENSE\n"
  for i, name in files {
    let source = @fs.read_file("integration/reference/etl/" + name + ".sql").text()
    output += "\n///|\nlet source_migration_sql_\{i} : String =\n"
    // split retains the final empty line, preserving the upstream final newline.
    for line in source.split("\n") {
      output += "  #|" + line.to_owned() + "\n"
    }
  }
  @fs.write_file("source_migrations_sql.mbt", output)
}
