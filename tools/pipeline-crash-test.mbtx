///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let built = @shell.Cmd("moon", [
    "test", "pipeline_process_wbtest.mbt", "--target", "native", "--build-only",
  ]).output()
  built.check()
  guard @json.parse(built.stdout())
    is { "artifacts_path": [String(executable)], .. } else {
    fail("expected one native whitebox executable")
  }
  let port = if @env.get_env_var("MOONCDC_EXAMPLE_SERVICE") == Some("pg17") {
    "55417"
  } else {
    "55418"
  }
  let dir = @fs.tmpdir(prefix="mooncdc-pipeline-kill-")
  defer @fs.rmdir(dir, recursive=true)
  let args = ["pipeline_process_wbtest.mbt:0-1"]
  let vars = {
    "MOONCDC_TEST_PORT": port,
    "MOONCDC_PIPELINE_DIR": dir,
    "MOONCDC_PIPELINE_PHASE": "init",
  }
  let run = async fn(phase : String) -> Unit {
    vars["MOONCDC_PIPELINE_PHASE"] = phase
    let result = @shell.Cmd(executable, args, env=vars).output()
    result.check()
    if !result.stdout().contains("PIPELINE worker completed " + phase) {
      fail("worker failed: \{result.stdout()} \{result.stderr()}")
    }
  }
  run("init")
  defer run("cleanup")
  vars["MOONCDC_PIPELINE_PHASE"] = "crash"
  @async.with_task_group(group => {
    let child = @process.spawn(
      group,
      executable,
      args,
      extra_env=vars,
      cancel_handler=@process.hard_cancel(),
    )
    @async.with_timeout(30000, () => {
      while !@fs.exists(dir + "/ready") {
        if child.try_wait() is Some(code) {
          fail("crash worker exited before boundary: \{code}")
        }
        @async.sleep(25)
      }
    })
    @shell.Cmd("kill", ["-KILL", child.pid.to_string()]).run()
    assert_true(child.wait() != 0)
  })
  run("recover")
  println(
    "PIPELINE: SIGKILL after partial table persistence; fresh process preserves completed copy, resets interrupted copy and converges with WAL",
  )
}
