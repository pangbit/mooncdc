///|
fn runtime_metrics_config(config : Json, port : Int) -> Unit raise {
  guard config is { "metrics": metrics, .. } else {
    fail("metrics config required")
  }
  let fields = runtime_fields(metrics, ["port", "listen_address"])
  assert_true(port > 0 && port <= 65535)
  assert_eq(fields["port"], port.to_json())
  assert_eq(fields["listen_address"], "127.0.0.1".to_json())
}

///|

///|
fn audit_configuration(
  source_port : Int,
  state_port : Int,
  ch_port : Int,
  metrics_port : Int,
  engine : String,
  active_copy : Bool,
) -> Json {
  {
    "id": "cli-promotion",
    "source": {
      "host": "127.0.0.1",
      "port": source_port.to_json(),
      "user": "cdc",
      "password": "mooncdc-test-only",
      "security": "local_plaintext",
      "timeout_ms": (if active_copy { 120000 } else { 5000 }).to_json(),
    },
    "publication": "cli_promotion",
    "state": {
      "schema": "cli_promotion_state",
      "connection": {
        "host": "127.0.0.1",
        "port": state_port.to_json(),
        "user": "cdc",
        "password": "mooncdc-test-only",
        "security": "local_plaintext",
      },
    },
    "run_source_migrations": false,
    "replication_slot": { "failover": true },
    "destination": {
      "type": "clickhouse",
      "url": ("http://127.0.0.1:" + ch_port.to_string()).to_json(),
      "database": "cli_promotion",
      "user": "cdc",
      "password": "mooncdc-test-only",
      "engine": engine.to_json(),
    },
    "metrics": { "port": metrics_port.to_json(), "listen_address": "127.0.0.1" },
    "copy_concurrency": (if active_copy { 1 } else { 4 }).to_json(),
    "copy_connections_per_table": (if active_copy { 1 } else { 4 }).to_json(),
    "batch_rows": (if active_copy { 8 } else { 256 }).to_json(),
    "table_retry_delay_ms": (if active_copy { 1000 } else { 10000 }).to_json(),
  }
}

///|
fn config_int(value : Json) -> Int raise {
  guard value is Number(n, ..) else { fail("configuration integer required") }
  assert_false(n.is_nan() || n.is_inf())
  assert_true(n >= -2147483648.0 && n <= 2147483647.0)
  let i = n.to_int()
  assert_eq(n, i.to_double())
  i
}

///|
fn audit_config_text(config : Json, format : String) -> String raise {
  if format == "json" {
    return config.stringify(indent=2)
  }
  assert_eq(format, "yaml")
  guard config is Object(fields) else { fail("configuration object") }
  guard fields["source"] is Object(source) else { fail("source") }
  guard fields["state"] is { "connection": Object(state), .. } else {
    fail("state")
  }
  guard fields["destination"] is Object(dest) else { fail("destination") }
  guard fields["metrics"] is Object(metrics) else { fail("metrics") }
  let yaml =
    #|id: cli-promotion
    #|source:
    #|  host: 127.0.0.1
    #|  port: SOURCEPORT
    #|  user: cdc
    #|  password: mooncdc-test-only
    #|  security: local_plaintext
    #|  timeout_ms: QUERYBUDGET
    #|publication: cli_promotion
    #|state:
    #|  schema: cli_promotion_state
    #|  connection:
    #|    host: 127.0.0.1
    #|    port: STATEPORT
    #|    user: cdc
    #|    password: mooncdc-test-only
    #|    security: local_plaintext
    #|run_source_migrations: false
    #|replication_slot:
    #|  failover: true
    #|destination:
    #|  type: clickhouse
    #|  url: http://127.0.0.1:CHPORT
    #|  database: cli_promotion
    #|  user: cdc
    #|  password: mooncdc-test-only
    #|  engine: ENGINE
    #|metrics:
    #|  port: METRICSPORT
    #|  listen_address: 127.0.0.1
    #|copy_concurrency: COPYCONCURRENCY
    #|copy_connections_per_table: COPYREADERS
    #|batch_rows: BATCHROWS
    #|table_retry_delay_ms: RETRYDELAY
  yaml
  .replace_all(old="SOURCEPORT", new=config_int(source["port"]).to_string())
  .replace_all(
    old="QUERYBUDGET",
    new=config_int(source["timeout_ms"]).to_string(),
  )
  .replace_all(old="STATEPORT", new=config_int(state["port"]).to_string())
  .replace_all(
    old="CHPORT",
    new=runtime_text(dest, "url").split(":").last().unwrap().to_owned(),
  )
  .replace_all(old="ENGINE", new=runtime_text(dest, "engine"))
  .replace_all(old="METRICSPORT", new=config_int(metrics["port"]).to_string())
  .replace_all(
    old="COPYCONCURRENCY",
    new=config_int(fields["copy_concurrency"]).to_string(),
  )
  .replace_all(
    old="COPYREADERS",
    new=config_int(fields["copy_connections_per_table"]).to_string(),
  )
  .replace_all(
    old="BATCHROWS",
    new=config_int(fields["batch_rows"]).to_string(),
  )
  .replace_all(
    old="RETRYDELAY",
    new=config_int(fields["table_retry_delay_ms"]).to_string(),
  )
}

///|
/// Parse only the nested scalar mappings emitted by audit_config_text.
/// Unsupported YAML constructs and duplicate fields are rejected.
fn audit_parse_yaml(text : String) -> Json raise {
  let root : Map[String, Json] = Map([])
  let frames = [root]
  for raw in text.split("\n") {
    let line = raw.to_owned()
    if line.is_empty() {
      continue
    }
    assert_false(line.contains("\t") || line.contains("\r"))
    let mut spaces = 0
    for c in line.iter() {
      if c != ' ' {
        break
      }
      spaces += 1
    }
    assert_true(spaces % 2 == 0 && spaces <= 4)
    let level = spaces / 2
    while frames.length() > level + 1 {
      ignore(frames.pop())
    }
    assert_eq(frames.length(), level + 1, msg="unexpected YAML nesting")
    let parts = line[spaces:].split(":").collect()
    assert_true(parts.length() >= 2)
    let key = parts[0].to_owned()
    assert_true(
      !key.is_empty() &&
      key.iter().all(c => c.is_ascii_alphabetic() || c == '_'),
    )
    assert_false(
      frames[level].contains(key),
      msg="duplicate configuration field",
    )
    let value = parts[1:].join(":").trim().to_owned()
    if value.is_empty() {
      let child : Map[String, Json] = Map([])
      frames[level][key] = Json::object(child)
      frames.push(child)
    } else {
      assert_false(
        value
        .iter()
        .any(c => {
          c is ('&' | '*' | '!' | '{' | '}' | '[' | ']' | '#' | '\'' | '"')
        }),
      )
      frames[level][key] = if value == "true" ||
        value == "false" ||
        value.iter().all(c => c.is_ascii_digit() || c == '-') {
        @json.parse(value)
      } else {
        value.to_json()
      }
    }
  }
  Json::object(root)
}

///|
fn config_port(fields : Map[String, Json], key : String) -> Int raise {
  let port = config_int(fields[key])
  assert_true(port > 0 && port <= 65535)
  port
}

///|
fn config_expected_text(
  fields : Map[String, Json],
  key : String,
  expected : String,
) -> Unit raise {
  assert_true(
    fields[key] == expected.to_json(),
    msg="unexpected configuration field: " + key,
  )
}

///|
fn runtime_config_semantics(
  config : Json,
  scenario : CopyScenario,
  metrics_port : Int,
) -> Unit raise {
  let fields = runtime_fields(config, [
    "id", "source", "publication", "state", "run_source_migrations", "replication_slot",
    "destination", "metrics", "copy_concurrency", "copy_connections_per_table", "batch_rows",
    "table_retry_delay_ms",
  ])
  config_expected_text(fields, "id", "cli-promotion")
  config_expected_text(fields, "publication", "cli_promotion")
  assert_eq(fields["run_source_migrations"], false.to_json())
  let slot = runtime_fields(fields["replication_slot"], ["failover"])
  assert_eq(slot["failover"], true.to_json())
  let source = runtime_fields(fields["source"], [
    "host", "port", "user", "password", "security", "timeout_ms",
  ])
  let state = runtime_fields(fields["state"], ["schema", "connection"])
  config_expected_text(state, "schema", "cli_promotion_state")
  let conn = runtime_fields(state["connection"], [
    "host", "port", "user", "password", "security",
  ])
  for f in [source, conn] {
    config_expected_text(f, "host", "127.0.0.1")
    config_expected_text(f, "user", "cdc")
    config_expected_text(f, "password", "mooncdc-test-only")
    config_expected_text(f, "security", "local_plaintext")
  }
  assert_eq(config_int(source["timeout_ms"]), 120000)
  let dest = runtime_fields(fields["destination"], [
    "type", "url", "database", "user", "password", "engine",
  ])
  for
    (key, expected) in [
      ("type", "clickhouse"),
      ("database", "cli_promotion"),
      ("user", "cdc"),
      ("password", "mooncdc-test-only"),
      ("engine", scenario.engine),
    ] {
    config_expected_text(dest, key, expected)
  }
  let url = runtime_text(dest, "url").split(":").collect()
  assert_eq(url.length(), 3)
  assert_true(url[0] == "http" && url[1] == "//127.0.0.1")
  let ch_port = @string.parse_int(url[2])
  assert_true(ch_port > 0 && ch_port <= 65535 && url[2] == ch_port.to_string())
  runtime_metrics_config(config, metrics_port)
  let ports = [
    config_port(source, "port"),
    config_port(conn, "port"),
    ch_port,
    metrics_port,
  ]
  for i in 0..<ports.length() {
    for j in 0..<i {
      assert_false(ports[i] == ports[j], msg="fixture ports must be distinct")
    }
  }
  for
    (key, expected) in [
      ("copy_concurrency", 1),
      ("copy_connections_per_table", 1),
      ("batch_rows", 8),
      ("table_retry_delay_ms", 1000),
    ] {
    assert_eq(config_int(fields[key]), expected)
  }
}

///|
async fn runtime_generate_configs(out : String) -> Unit {
  @fs.mkdir(out)
  for
    id in [
      "pg17-yaml-replacing_merge_tree", "pg17-yaml-merge_tree", "pg18-json-replacing_merge_tree",
      "pg18-json-merge_tree", "pg18-yaml-replacing_merge_tree", "pg18-yaml-merge_tree",
    ] {
    let scenario = runtime_scenario(id)
    @fs.mkdir(out + "/" + id)
    @fs.write_file(
      out + "/" + id + "/config." + scenario.format,
      audit_config_text(
        audit_configuration(32771, 32772, 32773, 32774, scenario.engine, true),
        scenario.format,
      ),
    )
  }
}

///|
async fn runtime_verify_config_file(
  path : String,
  scenario : CopyScenario,
  port : Int,
) -> Unit {
  assert_true(scenario.format == "json" || scenario.format == "yaml")
  assert_true(
    path.has_suffix("." + scenario.format),
    msg="configuration suffix and scenario format differ",
  )
  assert_eq(@fs.kind(path, follow_symlink=false), @fs.FileKind::Regular)
  assert_true(@fs.file_size(path) <= 65536L)
  let text = @fs.read_file(path).text()
  let config = if scenario.format == "json" {
    @json.parse(text)
  } else {
    audit_parse_yaml(text)
  }
  runtime_config_semantics(config, scenario, port)
  assert_true(
    audit_config_text(config, scenario.format) == text,
    msg="noncanonical generated configuration",
  )
}

///|
test "runtime metrics config requires enabled explicit IPv4 loopback" {
  runtime_metrics_config(
    { "metrics": { "port": 19000, "listen_address": "127.0.0.1" } },
    19000,
  )
  let bad : Array[Json] = [
    { "metrics": { "port": 19000 } },
    { "metrics": { "port": 19000, "listen_address": "0.0.0.0" } },
    { "metrics": { "port": 19000, "listen_address": "::" } },
    { "metrics": { "port": 19000, "listen_address": "localhost" } },
    {
      "metrics": {
        "port": 19000,
        "listen_address": "127.0.0.1",
        "enabled": false,
      },
    },
    { "metrics": { "port": 19001, "listen_address": "127.0.0.1" } },
  ]
  for config in bad {
    runtime_reject(() => runtime_metrics_config(config, 19000))
  }
}

