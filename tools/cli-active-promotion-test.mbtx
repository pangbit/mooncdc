  runtime_reject(() => runtime_disk_root(plan, root + "/child"))
  runtime_reject(() => runtime_disk_root(plan, "/tmp/../foreign"))
}

///|
async test "over-budget sample stops and executes only owned cleanup" {
  runtime_disk_assert(536870912L)
  let cleaned = Ref(false)
  let continued = Ref(false)
  try {
    defer @async.protect_from_cancel(() => {
      let failures = runtime_cleanup_attempts([() => cleaned.val = true])
      assert_true(failures.is_empty())
    })
    runtime_disk_assert(536870913L)
    continued.val = true
  } catch {
    _ => ()
  } noraise {
    _ => fail("over-budget must stop")
  }
  assert_true(cleaned.val)
  assert_false(continued.val)
}

