///|
async test "single runtime scenario is sealed and rejects omitted multiple or unprepared cases" {
  let runtime = decode_runtime(runtime_test_manifest(), 0L)
  assert_eq(runtime.scenario.id, "pg17-yaml-merge_tree")
  assert_eq(runtime.scenario.service, "pg17")
  assert_eq(runtime.scenario.format, "yaml")
  assert_eq(runtime.scenario.engine, "merge_tree")
  for
    bad in [
      "", "all", "pg17-json-replacing_merge_tree", "pg17-json-merge_tree", "pg19-json-merge_tree",
      "pg17-json-merge_tree,pg18-json-merge_tree", "pg17-json-merge_tree pg18-json-merge_tree",
      "PG17/JSON/MergeTree",
    ] {
    runtime_reject(() => ignore(runtime_scenario(bad)))
    guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
    fields["scenario"] = bad.to_json()
    runtime_reject(() => ignore(decode_runtime(Json::object(fields), 0L)))
  }
  for
    bad in [
      @json.parse("null"),
      ["pg17-json-merge_tree"].to_json(),
      ["pg17-json-merge_tree", "pg17-json-replacing_merge_tree"].to_json(),
      { "id": "pg17-json-merge_tree" },
    ] {
    guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
    fields["scenario"] = bad
    runtime_reject(() => ignore(decode_runtime(Json::object(fields), 0L)))
  }
  guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
  fields.remove("scenario")
  runtime_reject(() => ignore(decode_runtime(Json::object(fields), 0L)))
  let prefix = ["--runtime-only", "/tmp/x", "--manifest-sha256", "0".repeat(64)]
  for
    suffix in [
      [],
      ["--scenario"],
      ["--scenario", "all"],
      [
        "--scenario", "pg17-json-merge_tree", "--scenario", "pg17-json-merge_tree",
      ],
      ["--scenario", "pg17-json-merge_tree", "pg18-json-merge_tree"],
    ] {
    runtime_reject(() => ignore(runtime_args(prefix + suffix)))
  }
}

///|
async test "six scalar cases decode but unverified PG18 cannot execute" {
  for
    id in [
      "pg17-yaml-replacing_merge_tree", "pg17-yaml-merge_tree", "pg18-json-replacing_merge_tree",
      "pg18-json-merge_tree", "pg18-yaml-replacing_merge_tree", "pg18-yaml-merge_tree",
    ] {
    guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
    fields["scenario"] = id.to_json()
    if id.has_prefix("pg18-") {
      fields["postgres_image_id"] = "unverified".to_json()
    }
    let r = decode_runtime(Json::object(fields), 0L)
    assert_eq(r.scenario.id, id)
    assert_eq(
      id,
      r.scenario.service + "-" + r.scenario.format + "-" + r.scenario.engine,
    )
    if r.scenario.service == "pg18" {
      runtime_reject(() => ignore(runtime_image_gate(r.manifest)))
    } else {
      ignore(runtime_image_gate(r.manifest))
    }
  }
}

///|
async test "PG18 requires a bound immutable image identity and keeps PG17 pinned" {
  guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
  fields["scenario"] = "pg18-yaml-merge_tree".to_json()
  fields["postgres_image_id"] = ("sha256:" + "a".repeat(64)).to_json()
  let runtime = decode_runtime(Json::object(fields), 0L)
  assert_eq(runtime_image_gate(runtime.manifest), "sha256:" + "a".repeat(64))
  for
    bad in [
      "unverified",
      "sha256:" + "0".repeat(64),
      "sha256:" + "a".repeat(63),
      "sha256:" + "A".repeat(64),
    ] {
    fields["postgres_image_id"] = bad.to_json()
    runtime_reject(() => ignore(runtime_image_gate(Json::object(fields))))
  }
  fields["scenario"] = "pg17-yaml-merge_tree".to_json()
  fields["postgres_image_id"] = ("sha256:" + "a".repeat(64)).to_json()
  runtime_reject(() => ignore(decode_runtime(Json::object(fields), 0L)))
}

///|
async test "runtime preflight inspects the immutable image used by fixtures" {
  guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
  fields["scenario"] = "pg18-json-replacing_merge_tree".to_json()
  fields["postgres_image_id"] = "sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722".to_json()
  let runtime = decode_runtime(Json::object(fields), 0L)
  assert_eq(
    runtime_image_inspect_args(runtime)[2],
    runtime_image_gate(runtime.manifest),
  )
  fields["scenario"] = "pg17-yaml-merge_tree".to_json()
  fields["postgres_image_id"] = "sha256:d18fea728d846038da867214da83fb71ecfc8ca0a5e93a9cb8404b6f6f5070f0".to_json()
  let runtime = decode_runtime(Json::object(fields), 0L)
  assert_eq(
    runtime_image_inspect_args(runtime)[2],
    runtime_image_gate(runtime.manifest),
  )
}

///|
async test "fixed PG18 fixture covers its declared parent volume" {
  let cwd = @env.current_dir().unwrap()
  let repo = if cwd.has_suffix("/tools") {
    cwd[:cwd.length() - 6].to_owned()
  } else {
    cwd
  }
  let text = @fs.read_file(repo + "/integration/standby.compose.yaml").text()
  assert_eq(runtime_standby_compose("pg17", text), text)
  let changed = runtime_standby_compose("pg18", text)
  for volume in ["primary", "standby"] {
    assert_true(changed.contains(volume + ":/var/lib/postgresql\n"))
    assert_false(changed.contains(volume + ":/var/lib/postgresql/data"))
  }
  let f = runtime_storage_fixture()
  guard f["overlayfs_container"] is Object(fields) else { fail("fixture") }
  let row = fields.copy()
  for kind in ["volume", "tmpfs"] {
    row["mounts"] = if kind == "volume" {
      [
        {
          "Type": "volume",
          "Name": "mooncdccopy-0123456789abcdef_primary",
          "Source": "/var/lib/docker/volumes/mooncdccopy-0123456789abcdef_primary/_data",
          "Destination": "/var/lib/postgresql",
          "RW": true,
        },
      ]
    } else {
      [{ "Type": "tmpfs", "Destination": "/var/lib/postgresql", "RW": true }]
    }
    let plan = runtime_empty_disk()
    runtime_container_disk(
      plan,
      "overlayfs",
      "mooncdccopy-0123456789abcdef",
      "mooncdccopy0123456789abcdef.slice",
      "/tmp/mooncdc-copy-runtime-synthetic",
      "1".repeat(64),
      Json::object(row),
    )
    assert_eq(plan.volumes.length(), if kind == "volume" { 1 } else { 0 })
  }
}

///|
async test "PG18 basebackup creates data as the database user" {
  guard runtime_test_manifest() is Object(fields) else { fail("fixture") }
  fields["scenario"] = "pg18-json-replacing_merge_tree".to_json()
  fields["postgres_image_id"] = "sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722".to_json()
  let runtime = decode_runtime(Json::object(fields), 0L)
  assert_eq(audit_basebackup_options(Some(runtime), "owned"), [
    "run", "--name", "owned-basebackup", "--user", "postgres",
  ])
  assert_eq(audit_basebackup_options(None, "owned"), ["run", "--rm"])
  fields["scenario"] = "pg17-yaml-merge_tree".to_json()
  fields["postgres_image_id"] = "sha256:d18fea728d846038da867214da83fb71ecfc8ca0a5e93a9cb8404b6f6f5070f0".to_json()
  let runtime = decode_runtime(Json::object(fields), 0L)
  assert_eq(audit_basebackup_options(Some(runtime), "owned"), [
    "run", "--name", "owned-basebackup",
  ])
}

///|

///|
async test "six actual generated files pass the shared runtime readback guard" {
  let root = @fs.tmpdir(prefix="mooncdc-config-file-test-")
  defer @async.protect_from_cancel(() => @fs.rmdir(root, recursive=true))
  runtime_generate_configs(root + "/cases")
  for
    id in [
      "pg17-yaml-replacing_merge_tree", "pg17-yaml-merge_tree", "pg18-json-replacing_merge_tree",
      "pg18-json-merge_tree", "pg18-yaml-replacing_merge_tree", "pg18-yaml-merge_tree",
    ] {
    let s = runtime_scenario(id)
    runtime_verify_config_file(
      root + "/cases/" + id + "/config." + s.format,
      s,
      32774,
    )
  }
}

///|
async test "actual config file guard rejects format field type and semantic errors" {
  let root = @fs.tmpdir(prefix="mooncdc-config-rejection-test-")
  defer @async.protect_from_cancel(() => @fs.rmdir(root, recursive=true))
  let config = audit_configuration(
    32771, 32772, 32773, 32774, "replacing_merge_tree", true,
  )
  let yaml = audit_config_text(config, "yaml")
  for
    (id, format, text) in [
      ("pg18-json-replacing_merge_tree", "json", yaml),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        audit_config_text(config, "json"),
      ),
      ("pg17-yaml-replacing_merge_tree", "yaml", yaml + "\nunknown: true"),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        yaml.replace_all(
          old="  port: 32774",
          new="  port: 32774\n  port: 32774",
        ),
      ),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        yaml.replace_all(
          old="listen_address: 127.0.0.1",
          new="listen_address: 0.0.0.0",
        ),
      ),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        yaml.replace_all(
          old="engine: replacing_merge_tree",
          new="engine: merge_tree",
        ),
      ),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        yaml.replace_all(old="failover: true", new="failover: false"),
      ),
      (
        "pg17-yaml-replacing_merge_tree",
        "yaml",
        yaml.replace_all(old="source:", new="source: &alias"),
      ),
    ] {
    let file = root + "/config." + format
    @fs.write_file(file, text)
    try runtime_verify_config_file(file, runtime_scenario(id), 32774) catch {
      _ => ()
    } noraise {
      _ => fail("invalid configuration file accepted")
    }
  }
  guard config is Object(fields) else { fail("config") }
  for
    (key, value) in [
      ("unknown", true.to_json()),
      ("batch_rows", (9).to_json()),
      ("run_source_migrations", true.to_json()),
    ] {
    let bad = fields.copy()
    bad[key] = value
    let file = root + "/config.json"
    @fs.write_file(file, Json::object(bad).stringify(indent=2))
    try
      runtime_verify_config_file(
        file,
        runtime_scenario("pg18-json-replacing_merge_tree"),
        32774,
      )
    catch {
      _ => ()
    } noraise {
      _ => fail("invalid JSON field accepted")
    }
  }
}

///|
test "offline main selections cannot fall through to live modes" {
  assert_true(
    runtime_args(["--offline-generate-configs", "/tmp/configs"])
    is OfflineGenerateConfigs(_),
  )
  assert_true(
    runtime_args([
      "--offline-config-verify-only", "pg17-yaml-merge_tree", "/tmp/config.yaml",
      "--metrics-port", "32774",
    ])
    is OfflineConfig(_, _, _),
  )
  for
    args in [
      ["--offline-generate-configs"],
      ["--offline-generate-configs", "/tmp/configs", "extra"],
      ["--offline-config-verify-only", "pg17-yaml-merge_tree"],
      [
        "--offline-config-verify-only", "all", "/tmp/config.yaml", "--metrics-port",
        "32774",
      ],
      [
        "--offline-config-verify-only", "pg17-yaml-merge_tree", "/tmp/config.yaml",
        "--metrics-port", "0",
      ],
      [
        "--offline-config-verify-only", "pg17-yaml-merge_tree", "/tmp/config.yaml",
        "--metrics-port", "32774", "--runtime-only",
      ],
    ] {
    runtime_reject(() => ignore(runtime_args(args)))
  }
}

///|
async test "runtime byte verification rejects an altered sealed file" {
  let root = @fs.realpath(@fs.tmpdir(prefix="mooncdc-runtime-hash-test-"))
  defer @async.protect_from_cancel(() => @fs.rmdir(root, recursive=true))
  let file = root + "/input"
  @fs.write_file(file, "abc")
  runtime_file_hash(file, runtime_digest(b"abc"), 3)
  @fs.write_file(file, "abd")
  try runtime_file_hash(file, runtime_digest(b"abc"), 3) catch {
    _ => ()
  } noraise {
    _ => fail("changed artifact bytes accepted")
  }
}
