async test "mount fixtures reject foreign volumes and writable binds" {
  let f = runtime_storage_fixture()
  let project = match f["project"] {
    String(s) => s
    _ => panic()
  }
  let parent = match f["parent"] {
    String(s) => s
    _ => panic()
  }
  let root = match f["root"] {
    String(s) => s
    _ => panic()
  }
  guard f["overlayfs_container"] is Object(fields) else { fail("fixture") }
  for
    mount in (
      [
        {
          "Type": "volume",
          "Name": "foreign",
          "Source": "/var/lib/docker/volumes/foreign/_data",
          "Destination": "/var/lib/postgresql/data",
          "RW": true,
        },
        {
          "Type": "bind",
          "Source": "/tmp/private",
          "Destination": "/etc/mooncdc/pg_hba.conf",
          "RW": true,
