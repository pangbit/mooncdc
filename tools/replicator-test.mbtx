----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/http",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
fn clickhouse_test_endpoint(port : String?) -> String raise {
  let port = port.unwrap_or("18123")
  let parsed = @string.parse_int(port)
  assert_true(parsed > 0 && parsed <= 65535, msg="invalid ClickHouse test port")
  assert_eq(
    parsed.to_string(),
    port,
    msg="ClickHouse test port must be canonical decimal",
  )
  "http://127.0.0.1:" + port
}

///|
test "ClickHouse test endpoint keeps default and validates explicit loopback port" {
  assert_eq(clickhouse_test_endpoint(None), "http://127.0.0.1:18123")
  for port in ["1", "60123", "65535"] {
    assert_eq(clickhouse_test_endpoint(Some(port)), "http://127.0.0.1:" + port)
  }
  for
    port in [
      "", "0", "-1", "65536", "9999999999999999999999", "+1", "01", " 60123", "60123\n",
      "1.0", "127.0.0.1:60123", "http://remote:60123",
    ] {
    try clickhouse_test_endpoint(Some(port)) catch {
      _ => ()
    } noraise {
      _ => fail("invalid ClickHouse test port accepted")
    }
  }
}

///|
async fn main {
  @shell.Cmd("moon", ["build", "--target", "native"]).run()
  let executable = @env.current_dir().unwrap() +
    "/_build/native/debug/build/cmd/replicator/replicator.exe"
  let service = @env.get_env_var("MOONCDC_EXAMPLE_SERVICE").unwrap_or("pg18")
  assert_true(service == "pg17" || service == "pg18")
  let port = @env.get_env_var("MOONCDC_TEST_PORT")
    .map(port => @string.parse_int(port))
    .unwrap_or(if service == "pg17" { 55417 } else { 55418 })
  assert_true(port > 0 && port <= 65535)
  let clickhouse_endpoint = clickhouse_test_endpoint(
    @env.get_env_var("MOONCDC_CLICKHOUSE_PORT"),
  )
  let slot_failover = @env.get_env_var("MOONCDC_PIPELINE_FAILOVER") ==
    Some("true")
  let sql = async fn(query : String) -> String {
    let result = @shell.Cmd("docker", [
      "compose", "-p", "mooncdc-test", "-f", "integration/compose.yaml", "exec",
      "-T", service, "psql", "-U", "cdc", "-d", "postgres", "-v", "ON_ERROR_STOP=1",
      "-Atc", query,
    ]).output()
    result.check()
    result.stdout().trim().to_owned()
  }
  let ch = async fn(query : String) -> String {
    let result = @shell.Cmd("docker", [
      "compose", "-p", "mooncdc-clickhouse-test", "-f", "integration/clickhouse.compose.yaml",
      "exec", "-T", "clickhouse", "clickhouse-client", "--user", "cdc", "--password",
      "mooncdc-test-only", "--query", query,
    ]).output()
    result.check()
    result.stdout().trim().to_owned()
  }
  let dir = @fs.tmpdir(prefix="mooncdc-replicator-")
  defer @fs.rmdir(dir, recursive=true)
  // CREATE without IF NOT EXISTS refuses to take ownership of another fixture.
  ignore(sql("CREATE SCHEMA mooncdc_cli_test"))
  defer ignore(sql("DROP SCHEMA mooncdc_cli_test CASCADE"))
  assert_eq(sql("SELECT count(*) FROM pg_namespace WHERE nspname='etl'"), "0")
  defer ignore(
    sql(
      "DROP EVENT TRIGGER IF EXISTS supabase_etl_ddl_message_trigger; DROP SCHEMA IF EXISTS etl CASCADE",
    ),
  )
  ignore(
    sql(
      "CREATE TABLE mooncdc_cli_test.items(id integer PRIMARY KEY, value text NOT NULL); INSERT INTO mooncdc_cli_test.items VALUES(1,'copy'); CREATE PUBLICATION mooncdc_cli_test FOR TABLE mooncdc_cli_test.items",
    ),
  )
  defer ignore(sql("DROP PUBLICATION mooncdc_cli_test"))
  ignore(ch("CREATE DATABASE mooncdc_cli_test"))
  defer ignore(ch("DROP DATABASE mooncdc_cli_test"))
  let source : Json = {
    "host": "127.0.0.1",
    "port": Json::Json(port),
    "user": "cdc",
    "password": "mooncdc-test-only",
    "security": "local_plaintext",
  }
  let proxy = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  defer proxy.close()
  let config : Json = {
    "id": "cli-test",
    "run_source_migrations": true,
    "replication_slot": { "failover": Json::Json(slot_failover) },
    "publication": "mooncdc_cli_test",
    "source": source,
    "state": { "schema": "etl" },
    "destination": {
      "type": "clickhouse",
      "url": Json::Json("http://127.0.0.1:\{proxy.addr.port()}"),
      "user": "cdc",
      "password": "mooncdc-test-only",
      "database": "mooncdc_cli_test",
    },
    "health": { "port": 19091 },
    "batch_rows": 1,
  }
  @fs.write_file(dir + "/config.json", config.stringify())
  let yaml = @env.get_env_var("MOONCDC_REPLICATOR_FORMAT") == Some("yaml")
  let path = dir + (if yaml { "/config.yaml" } else { "/config.json" })
  if yaml {
    let content =
      #|id: cli-test
      #|run_source_migrations: true
      #|replication_slot:
      #|  failover: FAILOVER
      #|publication: mooncdc_cli_test
      #|source:
      #|  host: 127.0.0.1
      #|  port: PORT
      #|  user: cdc
      #|  password: mooncdc-test-only
      #|  security: local_plaintext
      #|state:
      #|  schema: etl
      #|destination:
      #|  type: clickhouse
      #|  url: http://127.0.0.1:PROXY
      #|  user: cdc
      #|  password: mooncdc-test-only
      #|  database: mooncdc_cli_test
      #|health:
      #|  port: 19091
      #|batch_rows: 1
    @fs.write_file(
      path,
      content
      .replace(old="FAILOVER", new=slot_failover.to_string())
      .replace(old="PORT", new=port.to_string())
      .replace(old="PROXY", new=proxy.addr.port().to_string()),
    )
  }
  @shell.Cmd(executable, ["--config", path, "--check"]).run()
  let slot_query = "SELECT (substring(convert_from(decode(content,'base64'),'UTF8') from 66)::jsonb #>> '{source,slot}') FROM etl.mooncdc_state WHERE namespace='cli-test/state' AND record='pipeline'"
  // Only the slot recorded by this exact fixture namespace is ours.
  defer ignore(
    sql(
      "SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name IN (" +
      slot_query +
      ")",
    ),
  )
  let current = "mooncdc_cli_test.mooncdc__cli__test_items__current"
  let mut phase = ""
  let mut gate = false
  let mut admitted = false
  let mut release = false
  @async.with_task_group(proxy_group => {
    proxy_group.spawn_bg(() => {
      proxy.run_forever(
        (tcp, _) => {
          let conn = @http.ServerConnection::new(tcp)
          defer conn.close()
          let request = conn.read_request()
          let body = conn.read_all()
          let insert = body.binary().has_prefix(b"INSERT")
          if gate && (insert || phase == "INIT") {
            admitted = true
            while !release {
              @async.sleep(5)
            }
            if phase == "FAIL" {
              conn.send_response(503, "Injected failure")
              conn.end_response()
              return
            }
          }
          let headers = Map([])
          for key, value in request.headers {
            if key.to_string().to_lower().has_prefix("x-clickhouse-") {
              headers[key] = value
            }
          }
          let (response, result) = @http.request(
            clickhouse_endpoint + request.path,
            request.meth,
            headers,
            body,
          )
          let headers = Map([])
          for key, value in response.headers {
            if key.to_string().to_lower().has_prefix("x-clickhouse-") ||
              key.to_string().to_lower() == "content-type" {
              headers[key] = value
            }
          }
          conn.send_response(
            response.code,
            response.reason,
            extra_headers=headers,
          )
          conn.write(result)
          conn.end_response()
        },
        allow_failure=false,
      )
    })
    for signal in ["INIT", "TERM", "INT", "FAIL", "RECOVER"] {
      phase = signal
      gate = signal == "INIT"
      admitted = false
      release = false
      if signal == "INT" {
        ignore(sql("INSERT INTO mooncdc_cli_test.items VALUES(3,'offline')"))
      }
      let output = @process.redirect_to_file(dir + "/worker.log")
      defer output.close()
      @async.with_task_group(group => {
        let child = @process.spawn(
          group,
          executable,
          ["--config", path],
          stdout=output,
          stderr=output,
          cancel_handler=@process.hard_cancel(),
        )
        @async.with_timeout(30000, () => {
          if signal == "INIT" {
            while !admitted {
              @async.sleep(5)
            }
            let (response, body) = @http.get("http://127.0.0.1:19091/readyz")
            assert_eq(response.code, 503)
            assert_eq(body.text(), "initializing")
            return
          }
          while true {
            if child.try_wait() is Some(code) {
              fail(
                "replicator exited: \{code}; \{@fs.read_file(dir + "/worker.log").text()}",
              )
            }
            let probe = @shell.Cmd("curl", [
              "--silent", "--max-time", "1", "--output", "/dev/null", "--write-out",
              "%{http_code}", "http://127.0.0.1:19091/readyz",
            ]).output()
            let rows = ch("SELECT count() FROM " + current) catch { _ => "" }
            if probe.stdout() == "200" &&
              rows ==
              (if signal == "TERM" {
                "1"
              } else if signal == "RECOVER" {
                "3"
              } else {
                "2"
              }) {
              break
            }
            @async.sleep(100)
          }
        })
        gate = signal == "INIT" || signal == "TERM" || signal == "FAIL"
        let checkpoint = sql(
          "SELECT content FROM etl.mooncdc_state WHERE namespace='cli-test/state' AND record='checkpoint'",
        )
        assert_false(checkpoint.is_empty())
        if signal == "TERM" || signal == "FAIL" {
          ignore(
            sql(
              if signal == "FAIL" {
                "INSERT INTO mooncdc_cli_test.items VALUES(4,'replay')"
              } else {
                "BEGIN; INSERT INTO mooncdc_cli_test.items VALUES(2,'insert'); UPDATE mooncdc_cli_test.items SET value='updated' WHERE id=2; DELETE FROM mooncdc_cli_test.items WHERE id=1; COMMIT"
              },
            ),
          )
          @async.with_timeout(15000, () => {
            while !admitted {
              @async.sleep(5)
            }
          })
        }
        @shell.Cmd("kill", [
          if signal == "INT" {
            "-INT"
          } else {
            "-TERM"
          },
          child.pid.to_string(),
        ]).run()
        if gate {
          @async.with_timeout(5000, () => {
            while true {
              let (response, body) = @http.get("http://127.0.0.1:19091/readyz")
              if response.code == 503 && body.text() == "stopping" {
                break
              }
              @async.sleep(5)
            }
          })
          assert_true(child.try_wait() is None)
          let (live, _) = @http.get("http://127.0.0.1:19091/livez")
          assert_eq(live.code, 200)
          release = true
        }
        let code = @async.with_timeout(15000, () => child.wait())
        assert_eq(code, if signal == "FAIL" { 1 } else { 0 })
        if signal == "FAIL" {
          assert_eq(
            sql(
              "SELECT content FROM etl.mooncdc_state WHERE namespace='cli-test/state' AND record='checkpoint'",
            ),
            checkpoint,
          )
          assert_eq(ch("SELECT count() FROM " + current), "2")
        }
        if signal == "INIT" {
          assert_eq(
            ch(
              "SELECT count() FROM system.tables WHERE database='mooncdc_cli_test'",
            ),
            "0",
          )
        }
        let log = @fs.read_file(dir + "/worker.log").text()
        assert_false(log.contains("WaitedTaskAlreadyCancelled"))
        if signal == "FAIL" {
          assert_true(log.contains("ClickHouse HTTP 503"))
        }
        println("REPLICATOR: \{service} \{signal}, drained exit=\{code}")
        group.return_immediately(())
      })
      assert_eq(
        sql(
          "SELECT count(*) FROM pg_replication_slots WHERE active AND slot_name IN (" +
          slot_query +
          ")",
        ),
        "0",
      )
      assert_eq(
        sql(
          "SELECT failover::text FROM pg_replication_slots WHERE slot_name IN (" +
          slot_query +
          ")",
        ),
        slot_failover.to_string(),
      )
      assert_eq(
        sql(
          "SELECT count(*) FROM etl.mooncdc_state WHERE namespace='cli-test/schemas' AND record='schemas'",
        ),
        "1",
      )
    }
    proxy_group.return_immediately(())
  })
  assert_eq(
    ch(
      "SELECT groupArray((id,value)) FROM (SELECT id,value FROM " +
      current +
      " ORDER BY id)",
    ),
    "[(2,'updated'),(3,'offline'),(4,'replay')]",
  )
  println(
    "REPLICATOR: persisted schema/state and fresh-process WAL recovery passed",
  )
}
