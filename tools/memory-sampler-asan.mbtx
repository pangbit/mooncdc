///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let dir = @fs.tmpdir(prefix="mooncdc-memory-asan-")
  defer @fs.rmdir(dir, recursive=true)
  let source =
    #|#include <assert.h>
    #|#include <stdint.h>
    #|#include <stdlib.h>
    #|#ifdef __APPLE__
    #|#include <mach/mach.h>
    #|#endif
    #|extern int32_t mooncdc_host_memory(uint8_t *);
    #|extern int32_t mooncdc_memory_platform(void);
    #|int main(void) {
    #|  uint8_t *out = malloc(16);
    #|  assert(out);
    #|#ifdef __APPLE__
    #|  mach_port_t port = mach_host_self();
    #|  mach_port_urefs_t before, after;
    #|  assert(mach_port_get_refs(mach_task_self(), port, MACH_PORT_RIGHT_SEND, &before) == KERN_SUCCESS);
    #|  assert(mooncdc_memory_platform() == 2);
    #|  for (int n = 0; n < 10000; ++n) {
    #|    assert(mooncdc_host_memory(out) == 1);
    #|    uint64_t total = 0, used = 0;
    #|    for (int i = 0; i < 8; ++i) {
    #|      used |= (uint64_t)out[i] << (8 * i);
    #|      total |= (uint64_t)out[8 + i] << (8 * i);
    #|    }
    #|    assert(total > 0 && used <= total);
    #|  }
    #|  assert(mach_port_get_refs(mach_task_self(), port, MACH_PORT_RIGHT_SEND, &after) == KERN_SUCCESS);
    #|  assert(before == after);
    #|  mach_port_deallocate(mach_task_self(), port);
    #|#elif defined(__linux__)
    #|  assert(mooncdc_memory_platform() == 1);
    #|  assert(mooncdc_host_memory(out) == 0);
    #|#endif
    #|  free(out);
    #|}
  @fs.write_file(dir + "/probe.c", source)
  let moon_home = @env.get_env_var("MOON_HOME").unwrap_or(
    @env.get_env_var("HOME").unwrap() + "/.moon",
  )
  @shell.Cmd("cc", [
    "-std=c11",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-fsanitize=address",
    "-fno-omit-frame-pointer",
    "-g",
    "-I" + moon_home + "/include",
    "internal/memory/host_memory.c",
    dir + "/probe.c",
    "-o",
    dir + "/probe",
  ]).run()
  @shell.Cmd(dir + "/probe", []).run()
  println(
    "MEMORY ASAN: native host sample buffer and Mach port ownership passed",
  )
}
