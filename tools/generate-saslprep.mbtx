----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
}
----

///|
fn digest(bytes : Bytes) -> String {
  let out = StringBuilder()
  let hex = "0123456789abcdef"
  for b in @crypto.sha256(bytes) {
    out.write_string(hex[b.to_int() / 16:b.to_int() / 16 + 1].to_owned())
    out.write_string(hex[b.to_int() % 16:b.to_int() % 16 + 1].to_owned())
  }
  out.to_string()
}

///|
// Extract a named C array, removing C comments before parsing its values.
fn body(source : String, name : String) -> String {
  let tail = source.split(name).nth(1).unwrap()
  let tail = tail.split("{").nth(1).unwrap()
  let raw = tail.split("};").next().unwrap()
  let out = StringBuilder()
  let mut comment = false
  let mut i = 0
  while i < raw.length() {
    if i + 1 < raw.length() && raw[i] == '/' && raw[i + 1] == '*' {
      comment = true
      i += 2
    } else if i + 1 < raw.length() && raw[i] == '*' && raw[i + 1] == '/' {
      comment = false
      i += 2
    } else {
      if !comment {
        out.write_string(raw[i:i + 1].to_owned())
      }
      i += 1
    }
  }
  out.to_string()
}

///|
fn number(value : StringView) -> Int32 raise {
  @string.parse_int(value.trim(), base=0)
}

///|
async fn main {
  let dir = "internal/saslprep/data/"
  let norm = @fs.read_file(dir + "unicode_norm_table.h")
  let prep = @fs.read_file(dir + "saslprep.c")
  guard digest(norm.binary()) ==
    "610b3c71ba92f8aecd36eec71910fac94e0f286abeb80e188f64c1adb031af6f" &&
    digest(prep.binary()) ==
    "a47ab6c21ce2a2ae4b8027108bf340d7a714d940d152774d2b9cc3fad31af998" else {
    abort("pinned PostgreSQL REL_18_0 source hash mismatch")
  }
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/generate-saslprep.mbtx; do not edit.\n// PostgreSQL REL_18_0, Unicode 16.0 normalization / RFC3454 Unicode 3.2 ranges.\n// Copyright PostgreSQL Global Development Group and Unicode, Inc.\n// Licenses and exact source hashes: data/README.md.\n",
  )
  for
    name in [
      "non_ascii_space_ranges", "commonly_mapped_to_nothing_ranges", "prohibited_output_ranges",
      "unassigned_codepoint_ranges", "RandALCat_codepoint_ranges", "LCat_codepoint_ranges",
    ] {
    let target = name.to_lower()
    out.write_string("\n///|\nlet \{target} : ReadOnlyArray[Int32] = [\n")
    for token in body(prep.text(), name + "[]").split(",") {
      if token.trim() != "" {
        out.write_string("  \{number(token)},\n")
      }
    }
    out.write_string("]\n")
  }
  // A flat record has codepoint, combining class, flags/length, and index.
  out.write_string("\n///|\nlet decompositions : ReadOnlyArray[Int32] = [\n")
  let section = norm
    .text()
    .split("UnicodeDecompMain[6843] =")
    .nth(1)
    .unwrap()
    .split("};")
    .next()
    .unwrap()
  let mut count = 0
  for line in section.split("\n") {
    let line = line.trim()
    if !line.has_prefix("{0x") {
      continue
    }
    let fields = line[1:].split("}").next().unwrap().split(",").collect()
    let mut flags = 0
    for flag in fields[2].split("|") {
      flags += match flag.trim().to_owned() {
        "DECOMP_NO_COMPOSE" => 128
        "DECOMP_INLINE" => 64
        "DECOMP_COMPAT" => 32
        value => number(value[:])
      }
    }
    out.write_string(
      "  \{number(fields[0])}, \{number(fields[1])}, \{flags}, \{number(fields[3])},\n",
    )
    count += 1
  }
  guard count == 6843 else { abort("incomplete normalization table") }
  out.write_string(
    "]\n\n///|\nlet decomposition_codepoints : ReadOnlyArray[Int32] = [\n",
  )
  let mut codepoint_count = 0
  for token in body(norm.text(), "UnicodeDecomp_codepoints[5138] =").split(",") {
    if token.trim() != "" {
      out.write_string("  \{number(token)},\n")
      codepoint_count += 1
    }
  }
  guard codepoint_count == 5138 else {
    abort("incomplete decomposition codepoints")
  }
  out.write_string("]\n")
  @fs.write_file("internal/saslprep/tables.mbt", out.to_string())
}
