  async fn write_rows(Self, Relation, ReadOnlyArray[ReadOnlyArray[Value]], TableCopyBatchId?) -> WriteStatus
  async fn finish_table_copy(Self, Relation) -> Unit = _
  async fn write_transaction(Self, Transaction) -> WriteStatus
  async fn flush(Self) -> Unit
}

pub(open) trait SchemaStore {
  async fn get(Self, UInt, SchemaId) -> SchemaSnapshot?
  async fn all(Self) -> ReadOnlyArray[SchemaSnapshot]
  async fn put(Self, SchemaSnapshot) -> Unit
  async fn prune(Self, ReadOnlyArray[(UInt, SchemaId)]) -> Int
}

pub(open) trait StateStore {
  async fn acquire(Self, String) -> Unit
  async fn release(Self, String) -> Unit
  async fn load(Self, StateRecord) -> Bytes?
  async fn save(Self, String, StateRecord, Bytes) -> Unit
}
